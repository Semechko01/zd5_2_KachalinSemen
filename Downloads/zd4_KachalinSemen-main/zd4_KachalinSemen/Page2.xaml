<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zd4_KachalinSemen.Page2"
             Title="Курсы валют">
    <ContentPage.Resources>
        <StyleSheet Source="/mystyles.css"/>
    </ContentPage.Resources>
    <StackLayout Padding="30">
        <Label Text="Центробанк РФ:" StyleClass="label" />
        <Label Text="USD 80.000" Margin="10,10,10,10" StyleClass="label"/>
        <Label Text="EUR 86.000" Margin="10,10,10,10" StyleClass="label"/>
        <Label Text="Выберите дату:" Margin="170,-110,10,10" StyleClass="label"/>
        <DatePicker Margin="165,0,10,10" HeightRequest="50" WidthRequest="100" StyleClass="label"/>
    </StackLayout>

</ContentPage>