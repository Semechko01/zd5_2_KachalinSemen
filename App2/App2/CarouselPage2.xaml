<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App2.CarouselPage2"
             StyleClass="singw">
    <ContentPage.Resources>
        <StyleSheet Source="/mystyles.css" />
    </ContentPage.Resources>
    <StackLayout>
        <Slider MinimumTrackColor="Green" MaximumTrackColor="LightGray" ThumbColor="LightGreen" Margin="10,40,10,10"></Slider>
        <Picker x:Name="picker" StyleClass="pickers" TitleColor="White" Margin="130,10,130,10" Title="DROPDOWN"/>
    </StackLayout>
</ContentPage>